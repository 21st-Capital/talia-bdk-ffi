+impl ReplacementView {
+    /// Whether `outpoint` is an output of a replaced transaction or of one of its descendants.
+    pub(crate) fn excludes(&self, outpoint: OutPoint) -> bool {
+        self.excluded.contains(&outpoint.txid)
+    }
+
+    /// Whether a replaced transaction has a pending descendant that is not replaced too.
+    pub(crate) fn has_unnamed_pending_descendant(&self) -> bool {
+        !self.unnamed_pending_descendants.is_empty()
+    }
+}
