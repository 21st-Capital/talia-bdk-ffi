+            if chunk.len() < 2 {
+                continue;
+            }
+            let mut batch = Batch::default();
+            for txid in chunk {
+                batch.transaction_get(txid);
+            }
+            let answers = match self.inner.batch_call(&batch) {
+                Ok(answers) if answers.len() == chunk.len() => answers,
+                Err(Error::Protocol(_)) => continue,
+                _ => return,
+            };
